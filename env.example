# Configure apenas se usar --tts openai.
# NUNCA compartilhe ou publique este arquivo preenchido.
OPENAI_API_KEY=
# Modelo da Speech API vigente em outubro/2026; depreciado para janeiro/2027.
# Antes dessa data, atualizar esta integração para um fluxo Realtime compatível.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
